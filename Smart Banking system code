        cout << "Invalid account type.\n";
        cin.clear();
        cin.ignore(numeric_limits<streamsize>::max(), '\n');
        return;
    }

    cout << "Enter opening balance: ";

    if (!(cin >> amount) || amount < 0) {
        cout << "Invalid opening balance.\n";
        cin.clear();
        cin.ignore(numeric_limits<streamsize>::max(), '\n');
        return;
    }

    int number = 1001;

    for (const auto& account : accounts) {
        if (account->getAccountNumber() >= number)
            number = account->getAccountNumber() + 1;
    }

    if (type == 1) {
        accounts.push_back(
            make_unique<SavingsAccount>(number, name, amount));
    } else {
        accounts.push_back(
            make_unique<CurrentAccount>(number, name, amount));
    }

    saveAccounts();
    logTransaction("Account created: " + to_string(number));

    cout << "Account created successfully!\n";
    cout << "Your account number is: " << number << '\n';
}

void displayAccounts() {
    if (accounts.empty()) {
        cout << "No accounts available.\n";
        return;
    }

    for (const auto& account : accounts) {
        cout << fixed << setprecision(2);
        cout << "\nAccount Number: "
             << account->getAccountNumber();
        cout << "\nCustomer Name: "
             << account->getCustomerName();
        cout << "\nAccount Type: " << account->getType();
        cout << "\nBalance: Rs. " << account->getBalance();
        cout << "\nInterest Rate: "
             << account->interestRate() << "%\n";
    }
}

void depositMoney() {
    int number;
    double amount;

    cout << "Enter account number: ";

    if (!(cin >> number)) {
        cout << "Invalid account number.\n";
        cin.clear();
        cin.ignore(numeric_limits<streamsize>::max(), '\n');
        return;
    }

    BankAccount* account = findAccount(number);

    if (!account) {
        cout << "Account not found.\n";
        return;
    }

    cout << "Enter deposit amount: ";

    if (!(cin >> amount)) {
        cout << "Invalid amount.\n";
        cin.clear();
        cin.ignore(numeric_limits<streamsize>::max(), '\n');
        return;
    }

    try {
        account->deposit(amount);
        saveAccounts();
        logTransaction("Deposit: Account " + to_string(number) +
                       ", Amount " + to_string(amount));

        cout << "Deposit successful!\n";
        cout << "Updated Balance: Rs. "
             << fixed << setprecision(2)
             << account->getBalance() << '\n';
    } catch (const exception& e) {
        cout << e.what() << '\n';
    }
}

