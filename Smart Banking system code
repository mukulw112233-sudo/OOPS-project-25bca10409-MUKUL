void showTransactions() {
    ifstream file("transactions.txt");
    string line;

    if (!file) {
        cout << "No transaction history available.\n";
        return;
    }

    cout << "\n===== TRANSACTION HISTORY =====\n";

    while (getline(file, line))
        cout << line << '\n';
}

