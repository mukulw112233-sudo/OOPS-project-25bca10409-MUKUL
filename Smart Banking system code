        if (!(cin >> choice)) {
            cout << "Please enter a valid number.\n";
            cin.clear();
            cin.ignore(numeric_limits<streamsize>::max(), '\n');
            continue;
        }

        try {
            switch (choice) {
                case 1:
                    createAccount();
                    break;
                case 2:
                    displayAccounts();
                    break;
                case 3:
                    depositMoney();
                    break;
                case 4:
                    withdrawMoney();
                    break;
                case 5:
                    transferMoney();
                    break;
                case 6:
                    checkBalance();
                    break;
                case 7:
                    showTransactions();
                    break;
                case 8:
                    cout << "Thank you for using Smart Banking System!\n";
