using namespace std;

class BankAccount {
private:
    int accountNumber;
    string customerName;
    double balance;

public:
    BankAccount(int number, string name, double amount)
        : accountNumber(number), customerName(name), balance(amount) {
        if (amount < 0)
            throw invalid_argument("Invalid opening balance");
    }

    virtual ~BankAccount() = default;

    int getAccountNumber() const {
        return accountNumber;
    }

    string getCustomerName() const {
        return customerName;
    }

    double getBalance() const {
        return balance;
    }

    void deposit(double amount) {
        if (amount <= 0)
            throw invalid_argument("Amount must be positive");

        balance += amount;
    }

    void withdraw(double amount) {
        if (amount <= 0)
            throw invalid_argument("Amount must be positive");

        if (amount > balance)
            throw runtime_error("Insufficient balance");

        balance -= amount;
    }

    virtual string getType() const = 0;
    virtual double interestRate() const = 0;
};

class SavingsAccount : public BankAccount {
public:
    SavingsAccount(int number, string name, double amount)
        : BankAccount(number, name, amount) {}

    string getType() const override {
        return "Savings";
    }

    double interestRate() const override {
        return 4.0;
    }
};

class CurrentAccount : public BankAccount {
public:
    CurrentAccount(int number, string name, double amount)
        : BankAccount(number, name, amount) {}

    string getType() const override {
        return "Current";
    }

    double interestRate() const override {
        return 0.0;
    }
};

vector<unique_ptr<BankAccount>> accounts;

BankAccount* findAccount(int number) {
    for (auto& account : accounts) {
        if (account->getAccountNumber() == number)
            return account.get();
    }
    return nullptr;
}

void saveAccounts() {
    ofstream file("accounts.txt");

    if (!file)
        throw runtime_error("Unable to save account data");

    file << fixed << setprecision(2);

    for (const auto& account : accounts) {
        file << account->getAccountNumber() << '|'
             << account->getCustomerName() << '|'
             << account->getType() << '|'
             << account->getBalance() << '\n';
    }
}

void loadAccounts() {
    ifstream file("accounts.txt");
    string line;

    while (getline(file, line)) {
        stringstream ss(line);
        string numberText, name, type, balanceText;

        if (!getline(ss, numberText, '|') ||
            !getline(ss, name, '|') ||
            !getline(ss, type, '|') ||
            !getline(ss, balanceText, '|'))
            continue;

        try {
            int number = stoi(numberText);
            double balance = stod(balanceText);

            if (findAccount(number))
                continue;

            if (type == "Savings") {
                accounts.push_back(
                    make_unique<SavingsAccount>(
                        number, name, balance));
            } else if (type == "Current") {
                accounts.push_back(
                    make_unique<CurrentAccount>(
                        number, name, balance));
            }
        } catch (const exception&) {
            continue;
        }
    }
}

void logTransaction(const string& message) {
    ofstream file("transactions.txt", ios::app);

    if (!file)
        throw runtime_error("Unable to save transaction");

    file << message << '\n';
}

