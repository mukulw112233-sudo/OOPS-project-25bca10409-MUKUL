void transferMoney() {
    int senderNumber, receiverNumber;
    double amount;

    cout << "Enter sender account number: ";

    if (!(cin >> senderNumber)) {
        cout << "Invalid account number.\n";
        cin.clear();
        cin.ignore(numeric_limits<streamsize>::max(), '\n');
        return;
    }

    cout << "Enter receiver account number: ";

    if (!(cin >> receiverNumber)) {
        cout << "Invalid account number.\n";
        cin.clear();
        cin.ignore(numeric_limits<streamsize>::max(), '\n');
        return;
    }

    BankAccount* sender = findAccount(senderNumber);
    BankAccount* receiver = findAccount(receiverNumber);

    if (!sender || !receiver) {
        cout << "One or both accounts not found.\n";
        return;
    }

    if (senderNumber == receiverNumber) {
        cout << "Cannot transfer to the same account.\n";
        return;
    }

    cout << "Enter transfer amount: ";

    if (!(cin >> amount)) {
        cout << "Invalid amount.\n";
        cin.clear();
        cin.ignore(numeric_limits<streamsize>::max(), '\n');
        return;
    }

    try {
        sender->withdraw(amount);

        try {
            receiver->deposit(amount);
        } catch (...) {
            sender->deposit(amount);
            throw;
        }

        saveAccounts();

        logTransaction("Transfer from " + to_string(senderNumber) +
                       " to " + to_string(receiverNumber) +
                       ", Amount " + to_string(amount));

        cout << "Transfer successful!\n";
    } catch (const exception& e) {
        cout << e.what() << '\n';
    }
}

